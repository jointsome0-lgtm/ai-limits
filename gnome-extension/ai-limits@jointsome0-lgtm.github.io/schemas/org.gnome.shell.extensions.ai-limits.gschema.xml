<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.ai-limits" path="/org/gnome/shell/extensions/ai-limits/">
    <key name="refresh-interval" type="i">
      <default>60</default>
      <range min="15" max="86400"/>
      <summary>Refresh interval in seconds</summary>
    </key>
    <key name="panel-position" type="s">
      <default>'right'</default>
      <choices><choice value="left"/><choice value="center"/><choice value="right"/></choices>
      <summary>Panel section</summary>
    </key>
    <key name="panel-index" type="i">
      <default>0</default>
      <range min="0" max="100"/>
      <summary>Position within the panel section</summary>
    </key>
    <key name="command" type="s">
      <default>'ai-limits json'</default>
      <summary>Command producing schema 1 JSON</summary>
      <description>Parsed as arguments, not executed through a shell. Supports quoted paths, but not pipelines, variable expansion, or tilde expansion.</description>
    </key>
  </schema>
</schemalist>
